<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NewNews.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NewNews.MAUI"
    Title="NewNews.MAUI">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    
    <ShellContent 
    Title="Artikel" 
    ContentTemplate="{DataTemplate local:ArticleWebViewPage}" 
    Route="ArticleWebViewPage" />


    <Shell.TitleView>
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Padding="0,0,0,0">
            <Image Source="newnews_logo3.png" HeightRequest="20" Aspect="AspectFit"/>
        </HorizontalStackLayout>
    </Shell.TitleView>

    
</Shell>
