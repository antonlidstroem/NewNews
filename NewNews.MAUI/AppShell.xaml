<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NewNews.MAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:NewNews.MAUI"
    Title="NewNews.MAUI"
    
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
    Shell.ForegroundColor="{StaticResource TextPrimary}"
    Shell.TitleColor="{StaticResource TextPrimary}"
    Shell.NavBarHasShadow="False">
    
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />
    

    <Shell.TitleView>
        <HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Padding="0,0,0,0">
            <Image Source="newnews_logo3.png" HeightRequest="20" Aspect="AspectFit"/>
        </HorizontalStackLayout>
    </Shell.TitleView>

    
</Shell>
