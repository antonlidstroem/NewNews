<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NewNews.MAUI.ViewModels"
             xmlns:models="clr-namespace:NewNews.DAL.Models;assembly=NewNews.DAL"
             xmlns:dto="clr-namespace:NewNews.MAUI.Dto"
             x:DataType="vm:MainViewModel"
             x:Class="NewNews.MAUI.MainPage"
             x:Name="RootPage">

    <Grid Padding="10" RowDefinitions="Auto,Auto,Auto,Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

        <!-- Sökfält -->
        <Border Grid.Row="0" 
                Padding="12,8" 
                Margin="0,5"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkGray}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16">

            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Black}}" 
                        Offset="0,2" 
                        Radius="8" 
                        Opacity="0.1"/>
            </Border.Shadow>

            <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                <Entry Grid.Column="0"
                    Placeholder="Sök nyheter..." 
                       Text="{Binding NewsVM.SearchQuery}" 
                       BackgroundColor="Transparent"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource PrimaryDark}}"
                       PlaceholderColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                       ReturnCommand="{Binding NewsVM.SearchNewsCommand}"
                       VerticalOptions="Center"/>

                <!-- Endpoint Toggle -->
                <ImageButton Grid.Column="1"
                         WidthRequest="40"
                         HeightRequest="40"
                         Padding="8"
                         CornerRadius="8"
                         BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                         Command="{Binding NewsVM.ToggleEndpointCommand}">
                    <ImageButton.Triggers>
                        <DataTrigger TargetType="ImageButton"
                     Binding="{Binding NewsVM.SelectedEndpoint}"
                     Value="everything">
                            <Setter Property="Source" Value="everything.png"/>
                        </DataTrigger>

                        <DataTrigger TargetType="ImageButton"
                     Binding="{Binding NewsVM.SelectedEndpoint}"
                     Value="top-headlines">
                            <Setter Property="Source" Value="headline.png"/>
                        </DataTrigger>
                    </ImageButton.Triggers>
                </ImageButton>

                <ImageButton Grid.Column="2"
                            Source="search.png" 
                            Command="{Binding NewsVM.SearchNewsCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            WidthRequest="40"
                            HeightRequest="40"/>
                <ImageButton Grid.Column="3"
                            Source="delete.png" 
                            Command="{Binding NewsVM.ClearSearchCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            WidthRequest="40"
                            HeightRequest="40"/>
            </Grid>
        </Border>

        <!-- Endpoint väljare (Everything / Top Headlines) -->
        <!--
        <HorizontalStackLayout Grid.Row="1" Padding="5" Spacing="8" HorizontalOptions="Center">
            <Label Text="Källa:" VerticalOptions="Center" FontSize="12"/>
            <Picker ItemsSource="{Binding NewsVM.Endpoints}"
                    SelectedItem="{Binding NewsVM.SelectedEndpoint}"
                    WidthRequest="150"
                    FontSize="12"/>
        </HorizontalStackLayout>-->

        <!-- Filterknappar -->
        <HorizontalStackLayout Grid.Row="1" Padding="5" Spacing="8" HorizontalOptions="Center">
            <ImageButton Source="star.png" 
                        Command="{Binding SavedSearchVM.SaveSearchCommand}"
                        Style="{StaticResource IconButtonStyle}"/>
            <ImageButton Source="bookmark.png" 
                        Command="{Binding UiStateVM.ToggleSavedCommand}"
                        Style="{StaticResource IconButtonStyle}"/>
            <ImageButton Source="flag.png" 
                        Command="{Binding UiStateVM.ToggleLanguagesCommand}"
                        Style="{StaticResource IconButtonStyle}"/>
            <ImageButton Source="newsstand.png" 
                        Command="{Binding UiStateVM.ToggleSourcesCommand}"
                        Style="{StaticResource IconButtonStyle}"/>
        </HorizontalStackLayout>

        <!-- Filter collections -->
        <ScrollView Grid.Row="2" MaximumHeightRequest="400">
            <VerticalStackLayout Spacing="5">
                <!-- Språk -->
                <CollectionView 
                ItemsSource="{Binding LanguageVM.LanguageNames}"
                SelectionMode="Single"
                SelectedItem="{Binding LanguageVM.SelectedLanguage, Mode=TwoWay}"
                IsVisible="{Binding LanguageVM.IsLanguageCollectionVisible}"
                MaximumHeightRequest="200">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Padding="16,12" 
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding .}" 
                                   VerticalOptions="Center" 
                                   FontSize="14"
                                   FontAttributes="Bold"/>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Källor -->
                <CollectionView 
                ItemsSource="{Binding SourceVM.Sources}"
                SelectionMode="Single"
                SelectedItem="{Binding SourceVM.SelectedSource, Mode=TwoWay}"
                IsVisible="{Binding SourceVM.IsSourceCollectionVisible}"
                MaximumHeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:SourceDto">
                            <Border Padding="10,8" 
                                Margin="0,2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                                <Label Text="{Binding Name}" 
                                   FontSize="14"
                                   VerticalOptions="Center"/>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Sparade sökningar -->
                <CollectionView 
                ItemsSource="{Binding SavedSearchVM.SavedKeywords}"
                SelectionMode="Single"
                SelectedItem="{Binding SavedSearchVM.SelectedSavedSearch, Mode=TwoWay}"
                IsVisible="{Binding SavedSearchVM.AreSavedKeywordsVisible}"
                MaximumHeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SavedSearch">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems Mode="Execute">
                                        <SwipeItem Text="🗑️"
                                              BackgroundColor="Red"
                                              Command="{Binding BindingContext.SavedSearchVM.DeleteSavedSearchCommand, Source={x:Reference RootPage}}"
                                              CommandParameter="{Binding .}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Border Padding="10,8" 
                                    Margin="0,2"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                    <Label Text="{Binding Keyword}" 
                                       FontSize="14"
                                       VerticalOptions="Center"/>
                                </Border>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
        <!-- Artikellista med infinite scroll -->
        <RefreshView Grid.Row="4" 
                     Command="{Binding NewsVM.SearchNewsCommand}"
                     IsRefreshing="{Binding NewsVM.IsBusy}">
            <CollectionView ItemsSource="{Binding NewsVM.Articles}" 
                           SelectionMode="None"
                           RemainingItemsThreshold="2"
                           RemainingItemsThresholdReachedCommand="{Binding NewsVM.LoadMoreNewsCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArticleViewModel">
                        <Border Padding="10" 
                                Margin="5"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Title}" 
                                       FontSize="16" 
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap"/>

                                <Image Source="{Binding ImageUrl}" 
                                       HeightRequest="150" 
                                       Aspect="AspectFill">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding ImageUrl}" Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image" Binding="{Binding ImageUrl}" Value="">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>

                                <Label Text="{Binding Description}" 
                                       FontSize="14"
                                       LineBreakMode="WordWrap"
                                       MaxLines="3"/>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Source}" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                                    <Label Text="{Binding PublishedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                           HorizontalOptions="EndAndExpand"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.NewsVM.OpenArticleCommand, Source={x:Reference RootPage}}"
                                                     CommandParameter="{Binding Url}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Label Text="Inga artiklar hittades" 
                               FontSize="16" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                        <Label Text="Prova en annan sökning eller ändra filter" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>