<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NewNews.MAUI.ViewModels"
             xmlns:models="clr-namespace:NewNews.DAL.Models;assembly=NewNews.DAL"
             x:DataType="vm:MainViewModel"
             x:Class="NewNews.MAUI.MainPage"
             x:Name="RootPage">

    <Grid Padding="10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

        <!-- Row 1: Sökfält -->
        <HorizontalStackLayout Grid.Row="1" Spacing="5">
            <Entry Placeholder="" Text="{Binding SearchQuery}" HorizontalOptions="FillAndExpand"/>
            <Button Text="🔍" Command="{Binding SearchNewsCommand}"/>
        </HorizontalStackLayout>

        <!-- Row 2: Språk / kategori / spara sökning -->
        <HorizontalStackLayout Grid.Row="2" Spacing="10">

            <!-- Språk -->
            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                <!--<Label Text="Språk:" VerticalOptions="Center"/>-->
                <Picker ItemsSource="{Binding LanguageNames}" SelectedItem="{Binding SelectedLanguage}" Title="🌐"/>
            </HorizontalStackLayout>

            <!-- Kategori (endast för engelska) -->
            <HorizontalStackLayout Spacing="5" VerticalOptions="Center" IsVisible="{Binding IsCategoryVisible}">
                <!--<Label Text="Kategori:" VerticalOptions="Center"/>-->
                <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Title="🏷️"/>
            </HorizontalStackLayout>

            <!-- Spara sökning -->
            <Button Text="💾" Command="{Binding SaveSearchCommand}"/>

        </HorizontalStackLayout>

        <!-- Row 3: Picker för sparade sökord -->
        <HorizontalStackLayout Grid.Row="3" Spacing="5" Padding="0,5,0,5" VerticalOptions="Center">
            <!--<Label Text="Sparade sökord:" VerticalOptions="Center"/>-->
            <Picker ItemsSource="{Binding SavedKeywords}"
                    ItemDisplayBinding="{Binding Keyword}"
                    SelectedItem="{Binding SelectedSavedSearch}"
                    Title="⭐"
                    HorizontalOptions="FillAndExpand"/>
        </HorizontalStackLayout>



        <!-- CollectionView ligger inuti SwipeView -->
        <CollectionView Grid.Row="5" ItemsSource="{Binding Articles}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:News">
                    <Border Style="{StaticResource ArticleFrameStyle}">
                        <VerticalStackLayout Style="{StaticResource ArticleVerticalStackStyle}">
                            <Label Text="{Binding Title}" Style="{StaticResource TitleLabelStyle}" />
                            <Image Source="{Binding ImageUrl}" HeightRequest="150" Aspect="AspectFill" BackgroundColor="#F0F0F0"
                               IsVisible="{Binding IsExpanded, Converter={StaticResource InverseBoolConverter}}" />
                            <Label Text="{Binding Description}" Style="{StaticResource DescriptionLabelStyle}"
                               IsVisible="{Binding IsExpanded, Converter={StaticResource InverseBoolConverter}}" />
                            <Button Text="{Binding Source}" Style="{StaticResource SourceLabelStyle}" BackgroundColor="Transparent"
                                TextColor="#888" Padding="0" HorizontalOptions="Start"
                                Command="{Binding SourceTappedCommand}" CommandParameter="{Binding Url}"
                                IsVisible="{Binding IsExpanded, Converter={StaticResource InverseBoolConverter}}" />
                            <Label Text="{Binding PublishedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}" Style="{StaticResource PublishedAtLabelStyle}"
                               IsVisible="{Binding IsExpanded, Converter={StaticResource InverseBoolConverter}}" />

                            <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="5">
                                <HorizontalStackLayout Spacing="5">
                                    <Button Text="✕ Stäng artikel" FontSize="14" WidthRequest="32" HeightRequest="32"
                                        BackgroundColor="#F0F0F0" TextColor="#333" CornerRadius="16"
                                        Command="{Binding BindingContext.ToggleNewsExpandedCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}" />
                                    <Button Text="🌐 Läs originalet" FontSize="12" Padding="6,2"
                                        Command="{Binding BindingContext.OpenInBrowserCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding Url}" />
                                </HorizontalStackLayout>

                                <WebView Source="{Binding Url}" 
                                         HeightRequest="{Binding WebViewHeight}" 
                                         Navigated="WebView_Navigated"/>

                            </VerticalStackLayout>

                        </VerticalStackLayout>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.ToggleNewsExpandedCommand, Source={x:Reference RootPage}}"
                                              CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>



    </Grid>
</ContentPage>

