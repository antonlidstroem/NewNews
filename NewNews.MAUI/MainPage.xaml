<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NewNews.MAUI.ViewModels"
             xmlns:models="clr-namespace:NewNews.DAL.Models;assembly=NewNews.DAL"
             x:DataType="vm:MainViewModel"
             x:Class="NewNews.MAUI.MainPage"
             x:Name="RootPage"
             Title="{Binding Title}">

    <Grid Padding="10" RowDefinitions="Auto,Auto,*">

        <!-- Sökfält -->
        <HorizontalStackLayout Grid.Row="0" Spacing="5">
            <Entry Placeholder="Sök nyheter"
                   Text="{Binding SearchQuery}"
                   HorizontalOptions="FillAndExpand"/>
            <Button Text="Sök"
                    Command="{Binding SearchNewsCommand}"/>
        </HorizontalStackLayout>

        <!-- Sparade sökord -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding SavedKeywords}"
                        SelectionMode="Single"
                        HeightRequest="50">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding Keyword}"
                            Command="{Binding BindingContext.SearchByKeywordCommand, Source={x:Reference RootPage}}"
                            CommandParameter="{Binding .}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Nyhetslista -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Articles}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:News">
                    <Border Style="{StaticResource ArticleFrameStyle}">
                        <VerticalStackLayout Style="{StaticResource ArticleVerticalStackStyle}">

                            <!-- Bild -->
                            <Image Source="{Binding ImageUrl}"
                                   HeightRequest="150"
                                   Aspect="AspectFill"
                                   BackgroundColor="#F0F0F0"/>

                            <!-- Text -->
                            <Label Text="{Binding Title}" Style="{StaticResource TitleLabelStyle}" />
                            <Label Text="{Binding Description}" Style="{StaticResource DescriptionLabelStyle}" />
                            <Label Text="{Binding Source}" Style="{StaticResource SourceLabelStyle}" />
                            <Label Text="{Binding PublishedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                                   Style="{StaticResource PublishedAtLabelStyle}" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
