<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NewNews.MAUI.ViewModels"
             xmlns:models="clr-namespace:NewNews.DAL.Models;assembly=NewNews.DAL"
             x:DataType="vm:MainViewModel"
             x:Class="NewNews.MAUI.MainPage"
             x:Name="RootPage"
             Title="{Binding Title}">

    <Grid Padding="10" RowDefinitions="Auto,Auto,Auto,*">

        <!--<HorizontalStackLayout Grid.Row="0" HorizontalOptions="Center" Padding="0,10,0,10">
            <Image Source="newnews_logo.png"   
                HeightRequest="50"
               Aspect="AspectFit"/>
        </HorizontalStackLayout>-->

        <!-- Sökfält -->
        <HorizontalStackLayout Grid.Row="1" Spacing="5">
            <Entry Placeholder="Sök nyheter"
                   Text="{Binding SearchQuery}"/>
            <Button Text="Sök"
                    Command="{Binding SearchNewsCommand}"/>
        </HorizontalStackLayout>

        <!-- Sparade sökord -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding SavedKeywords}"
                        SelectionMode="Single"
                        HeightRequest="50">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding Keyword}"
                            Command="{Binding BindingContext.SearchByKeywordCommand, Source={x:Reference RootPage}}"
                            CommandParameter="{Binding .}"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Nyhetslista -->
        <CollectionView Grid.Row="3"
                ItemsSource="{Binding Articles}"
                SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:News">
                    <Frame Style="{StaticResource ArticleFrameStyle}">
                        <VerticalStackLayout Style="{StaticResource ArticleVerticalStackStyle}">

                            <!-- Bild -->
                            <Image Source="{Binding ImageUrl}"
                           HeightRequest="150"
                           Aspect="AspectFill"
                           BackgroundColor="#F0F0F0"/>

                            <!-- Titel -->
                            <Label Text="{Binding Title}" Style="{StaticResource TitleLabelStyle}" />

                            <!-- Beskrivning / full artikel -->
                            <Label Text="{Binding Description}" Style="{StaticResource DescriptionLabelStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Text" Value="{Binding Content}" />
                                        <Setter Property="LineBreakMode" Value="WordWrap"/>
                                        <Setter Property="MaxLines" Value="0"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- Källa och datum -->
                            <!--<Label Text="{Binding Source}" Style="{StaticResource SourceLabelStyle}">
                                <Label.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding SourceTappedCommand}"
                                            CommandParameter="{Binding Url}" />
                                         </Label.GestureRecognizers>
                            </Label>-->

                            <Button Text="{Binding Source}"
                                Style="{StaticResource SourceLabelStyle}"
                                BackgroundColor="Transparent"
                                TextColor="#888"
                                Padding="0"
                                HorizontalOptions="Start"
                                Command="{Binding SourceTappedCommand}"
                                CommandParameter="{Binding Url}" />

                            <Label Text="{Binding PublishedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}"
                           Style="{StaticResource PublishedAtLabelStyle}" />

                        </VerticalStackLayout>

                        <!-- TapGesture på hela kortet -->
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BindingContext.ToggleNewsExpandedCommand, Source={x:Reference RootPage}}"
                                          CommandParameter="{Binding .}" />
                        </Frame.GestureRecognizers>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


    </Grid>
</ContentPage>
