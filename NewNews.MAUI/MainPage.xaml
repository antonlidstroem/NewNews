<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NewNews.MAUI.ViewModels"
             xmlns:models="clr-namespace:NewNews.DAL.Models;assembly=NewNews.DAL"
             xmlns:dto="clr-namespace:NewNews.MAUI.Dto"
             x:DataType="vm:MainViewModel"
             x:Class="NewNews.MAUI.MainPage"
             x:Name="RootPage">

    <Grid Padding="10" RowDefinitions="Auto,Auto,Auto,Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

        <!-- Sökfält -->
        <Border Grid.Row="0" 
                Padding="10,5" 
                Margin="0,5"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12">
            <HorizontalStackLayout Spacing="10">
                <Entry Placeholder="Sök nyheter..." 
                       Text="{Binding NewsVM.SearchQuery}" 
                       HorizontalOptions="FillAndExpand"
                       BackgroundColor="Transparent"
                       ReturnCommand="{Binding NewsVM.SearchNewsCommand}"/>
                <ImageButton Source="search.png" 
                            Command="{Binding NewsVM.SearchNewsCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            WidthRequest="36"
                            HeightRequest="36"/>
                <ImageButton Source="delete.png" 
                            Command="{Binding NewsVM.ClearSearchCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            WidthRequest="36"
                            HeightRequest="36"/>
            </HorizontalStackLayout>
        </Border>

        <!-- Endpoint väljare (Everything / Top Headlines) -->
        <HorizontalStackLayout Grid.Row="1" Padding="5" Spacing="10" HorizontalOptions="Center">
            <Label Text="Källa:" VerticalOptions="Center" FontSize="12"/>
            <Picker ItemsSource="{Binding NewsVM.Endpoints}"
                    SelectedItem="{Binding NewsVM.SelectedEndpoint}"
                    WidthRequest="150"
                    FontSize="12"/>
        </HorizontalStackLayout>

        <!-- Filterknappar -->
        <HorizontalStackLayout Grid.Row="2" Padding="5" Spacing="10" HorizontalOptions="Center">
            <ImageButton Source="star.png" 
                        Command="{Binding SavedSearchVM.SaveSearchCommand}"
                        Style="{StaticResource IconButtonStyle}"/>
            <ImageButton Source="bookmark.png" 
                        Command="{Binding UiStateVM.ToggleSavedCommand}"
                        Style="{StaticResource IconButtonStyle}"/>
            <ImageButton Source="flag.png" 
                        Command="{Binding UiStateVM.ToggleLanguagesCommand}"
                        Style="{StaticResource IconButtonStyle}"/>
            <ImageButton Source="newsmode.png" 
                        Command="{Binding UiStateVM.ToggleSourcesCommand}"
                        Style="{StaticResource IconButtonStyle}"/>
        </HorizontalStackLayout>

        <!-- Filter collections -->
        <VerticalStackLayout Grid.Row="3" Spacing="5">
            <!-- Språk -->
            <CollectionView 
                ItemsSource="{Binding LanguageVM.LanguageNames}"
                SelectionMode="Single"
                SelectedItem="{Binding LanguageVM.SelectedLanguage, Mode=TwoWay}"
                IsVisible="{Binding LanguageVM.IsLanguageCollectionVisible}"
                HeightRequest="50">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Padding="12,6" 
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding .}" 
                                   VerticalOptions="Center" 
                                   FontSize="12"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Källor -->
            <CollectionView 
                ItemsSource="{Binding SourceVM.Sources}"
                SelectionMode="Single"
                SelectedItem="{Binding SourceVM.SelectedSource, Mode=TwoWay}"
                IsVisible="{Binding SourceVM.IsSourceCollectionVisible}"
                MaximumHeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dto:SourceDto">
                        <Border Padding="10" 
                                Margin="2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                            <Label Text="{Binding Name}" FontSize="12"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Sparade sökningar -->
            <CollectionView 
                ItemsSource="{Binding SavedSearchVM.SavedKeywords}"
                SelectionMode="Single"
                SelectedItem="{Binding SavedSearchVM.SelectedSavedSearch, Mode=TwoWay}"
                IsVisible="{Binding SavedSearchVM.AreSavedKeywordsVisible}"
                MaximumHeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SavedSearch">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem Text="Ta bort"
                                              BackgroundColor="Red"
                                              Command="{Binding BindingContext.SavedSearchVM.DeleteSavedSearchCommand, Source={x:Reference RootPage}}"
                                              CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Border Padding="10" 
                                    Margin="2"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 8">
                                <Label Text="{Binding Keyword}" FontSize="12"/>
                            </Border>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <!-- Artikellista med infinite scroll -->
        <RefreshView Grid.Row="4" 
                     Command="{Binding NewsVM.SearchNewsCommand}"
                     IsRefreshing="{Binding NewsVM.IsBusy}">
            <CollectionView ItemsSource="{Binding NewsVM.Articles}" 
                           SelectionMode="None"
                           RemainingItemsThreshold="2"
                           RemainingItemsThresholdReachedCommand="{Binding NewsVM.LoadMoreNewsCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArticleViewModel">
                        <Border Padding="10" 
                                Margin="5"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray700}}"
                                StrokeShape="RoundRectangle 12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Title}" 
                                       FontSize="16" 
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap"/>

                                <Image Source="{Binding ImageUrl}" 
                                       HeightRequest="150" 
                                       Aspect="AspectFill">
                                    <Image.Triggers>
                                        <DataTrigger TargetType="Image" Binding="{Binding ImageUrl}" Value="{x:Null}">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Image" Binding="{Binding ImageUrl}" Value="">
                                            <Setter Property="IsVisible" Value="False"/>
                                        </DataTrigger>
                                    </Image.Triggers>
                                </Image>

                                <Label Text="{Binding Description}" 
                                       FontSize="14"
                                       LineBreakMode="WordWrap"
                                       MaxLines="3"/>

                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding Source}" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                                    <Label Text="{Binding PublishedAt, StringFormat='{0:yyyy-MM-dd HH:mm}'}" 
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"
                                           HorizontalOptions="EndAndExpand"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BindingContext.NewsVM.OpenArticleCommand, Source={x:Reference RootPage}}"
                                                     CommandParameter="{Binding Url}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Label Text="Inga artiklar hittades" 
                               FontSize="16" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                        <Label Text="Prova en annan sökning eller ändra filter" 
                               FontSize="12" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>