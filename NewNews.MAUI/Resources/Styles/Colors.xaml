<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Primära färger - Djup blå ton för professionell nyhetskänsla -->
    <Color x:Key="Primary">#1E3A8A</Color>
    <!-- Djup blå -->
    <Color x:Key="PrimaryDark">#1E40AF</Color>
    <!-- Ljusare blå för mörkt läge -->
    <Color x:Key="PrimaryLight">#3B82F6</Color>
    <!-- Ljus accent blå -->

    <!-- Sekundära färger - Varm orange för kontrast -->
    <Color x:Key="Secondary">#F59E0B</Color>
    <!-- Amber/Orange -->
    <Color x:Key="SecondaryDark">#D97706</Color>
    <!-- Mörkare orange -->

    <!-- Accent färger -->
    <Color x:Key="Accent">#10B981</Color>
    <!-- Grön för framgång -->
    <Color x:Key="Danger">#EF4444</Color>
    <!-- Röd för varningar -->

    <!-- Neutrala färger - Light mode -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffWhite">#F8FAFC</Color>
    <Color x:Key="LightGray">#F1F5F9</Color>

    <!-- Neutrala färger - Dark mode -->
    <Color x:Key="OffBlack">#0F172A</Color>
    <Color x:Key="DarkGray">#1E293B</Color>

    <!-- Gråskala -->
    <Color x:Key="Gray50">#F8FAFC</Color>
    <Color x:Key="Gray100">#F1F5F9</Color>
    <Color x:Key="Gray200">#E2E8F0</Color>
    <Color x:Key="Gray300">#CBD5E1</Color>
    <Color x:Key="Gray400">#94A3B8</Color>
    <Color x:Key="Gray500">#64748B</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray700">#334155</Color>
    <Color x:Key="Gray800">#1E293B</Color>
    <Color x:Key="Gray900">#0F172A</Color>
    <Color x:Key="Gray950">#020617</Color>

    <!-- Text färger -->
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextPrimaryDark">#F1F5F9</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
</ResourceDictionary>